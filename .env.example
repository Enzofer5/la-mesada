# Copiá este archivo como ".env" y completá los valores. NUNCA subas el .env a internet.

# Clave secreta para firmar sesiones y formularios (usá una larga y aleatoria):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=la_mesada
DB_USER=lamesada
DB_PASSWORD=cambiar
# (alternativa: una sola URL)  DATABASE_URL=mysql+pymysql://usuario:clave@host:3306/la_mesada?charset=utf8mb4

# Nombre que se muestra en la pantalla de ingreso
APP_NOMBRE=La Mesada
APP_SUBTITULO=Sistema de Gestión Agrícola

# Poner en 1 cuando el sitio funcione con HTTPS (producción)
SESSION_COOKIE_SECURE=0
SESSION_HORAS=12
MAX_UPLOAD_MB=10
POR_PAGINA=25
# FLASK_DEBUG=1    # sólo en desarrollo
